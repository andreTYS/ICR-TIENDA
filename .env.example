# Dominio público por el que Traefik enrutará la tienda (usado en docker-compose.yml)
DOMAIN=tienda.icrinversiones.pe

# Integración con el ERP (ICR-LOGISTICA). Server-side únicamente — nunca se
# exponen al navegador (ver src/lib/erp.ts). Sin estas dos variables la tienda
# sigue funcionando con el catálogo estático de ejemplo (src/data/products.ts).
#
# ERP_API_TOKEN se emite desde el ERP en Administración → Tokens de servicio,
# "actuando como" un usuario con rol VENTAS (permisos: inventory.product.read,
# inventory.stock.read, crm.lead.create). El token es de larga duración.
ERP_API_URL=https://erp.inversionesicr.com/api
ERP_API_TOKEN=
