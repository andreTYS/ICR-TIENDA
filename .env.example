# Dominio público que Traefik enruta a la tienda
DOMAIN=tienda.inversiones.icr

# PostgreSQL (el volumen se inicializa con db/init/*.sql la primera vez)
POSTGRES_DB=productos_icr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave

# Acceso al panel https://DOMAIN/admin/ para cargar productos
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave_tambien
