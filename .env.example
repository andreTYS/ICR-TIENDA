# ---------- Dominio ----------
# Registro DNS tipo A: tienda -> IP del VPS (la misma de erp.inversionesicr.com)
DOMAIN=tienda.inversionesicr.com

# ---------- Traefik compartido del VPS (el mismo que usan el ERP y la web) ----------
# Verificar con:  docker inspect n8n-traefik-1 --format '{{json .Config.Cmd}}' | tr ',' '\n' | grep -i resolvers
TRAEFIK_NETWORK=n8n_default
TRAEFIK_CERTRESOLVER=mytlschallenge

# ---------- PostgreSQL de la tienda (el volumen se inicializa con db/init/*.sql la primera vez) ----------
POSTGRES_DB=productos_icr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave

# ---------- Panel https://DOMAIN/admin/ ----------
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave_tambien

# ---------- Integración con el ERP ----------
# Token de servicio creado en el ERP: Administración → Tokens de servicio,
# actuando como un usuario con rol VENTAS (empieza con "icr_").
# Vacío = la tienda funciona igual, sin stock del ERP y con las cotizaciones pendientes de envío.
ERP_API_URL=https://erp.inversionesicr.com/api
ERP_API_TOKEN=
